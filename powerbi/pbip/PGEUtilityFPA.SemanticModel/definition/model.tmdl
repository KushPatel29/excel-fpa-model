model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_month", "dim_class", "fact_sales", "fact_weather", "weather_impact", "weather_model", "plan_monthly", "plan_bridge", "forecast_monthly", "backtest", "tornado", "sensitivity", "pvm", "ferc_pnl", "ferc_years", "peers", "tieout", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_month
ref table dim_class
ref table fact_sales
ref table fact_weather
ref table weather_impact
ref table weather_model
ref table plan_monthly
ref table plan_bridge
ref table forecast_monthly
ref table backtest
ref table tornado
ref table sensitivity
ref table pvm
ref table ferc_pnl
ref table ferc_years
ref table peers
ref table tieout
ref table _Measures
ref table RateChange
ref table LoadChange
