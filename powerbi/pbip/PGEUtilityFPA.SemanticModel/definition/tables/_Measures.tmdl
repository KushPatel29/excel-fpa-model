table _Measures
	lineageTag: b3af0e1a-e074-5138-8219-b2afbf523da6

	measure 'Fiscal year' = YEAR(CALCULATE(MAX(fact_sales[month]), REMOVEFILTERS()))
		formatString: 0
		lineageTag: 64554af1-987a-54a0-821c-46d02fd002b2
		displayFolder: 00 Calendar

	measure 'Months closed' = MONTH(CALCULATE(MAX(fact_sales[month]), REMOVEFILTERS()))
		formatString: 0
		lineageTag: e8337d18-d66b-576f-b3ac-f65978e83346
		displayFolder: 00 Calendar

	measure 'Retail revenue' = SUM(fact_sales[revenue])
		formatString: \$#,0
		lineageTag: 972ea86d-3cf6-55b6-ae84-6298377ebf34
		displayFolder: 01 Sales

	measure 'Retail MWh' = SUM(fact_sales[mwh])
		formatString: #,0
		lineageTag: 0339a589-f851-5a21-8ac5-33f583c95aa6
		displayFolder: 01 Sales

	measure 'Average customers' = AVERAGEX(VALUES(dim_month[month]), CALCULATE(SUM(fact_sales[customers])))
		formatString: #,0
		lineageTag: 0d8db750-2cc5-56d3-bb39-84fae37786ff
		displayFolder: 01 Sales

	measure 'Retail price (cents/kWh)' = DIVIDE([Retail revenue], [Retail MWh]) / 10
		formatString: 0.00
		lineageTag: 4599f376-1764-5046-a56f-bcae9307a494
		displayFolder: 01 Sales

	measure 'MWh per customer' = DIVIDE([Retail MWh], [Average customers])
		formatString: 0.000
		lineageTag: 0d451f54-0f33-5f22-87c4-f7ee25fa06d2
		displayFolder: 01 Sales

	measure 'Retail revenue last year' =
			VAR vShift = 12
			RETURN CALCULATE(
			    [Retail revenue],
			    ALL(dim_month),
			    TREATAS(
			        SELECTCOLUMNS(VALUES(dim_month[month_index]),
			                      "month_index", dim_month[month_index] - vShift),
			        dim_month[month_index]
			    )
			)
		formatString: \$#,0
		lineageTag: 0dd15e06-431c-5dbb-a9ae-ea1a9f25463f
		displayFolder: 01 Sales

	measure 'Revenue YoY %' = DIVIDE([Retail revenue] - [Retail revenue last year], [Retail revenue last year])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 9ab726c3-f595-5cea-b007-8a4eec36b243
		displayFolder: 01 Sales

	measure 'Actual this year' =
			VAR vFY = [Fiscal year]
			RETURN CALCULATE([Retail revenue], dim_month[year] = vFY)
		formatString: \$#,0
		lineageTag: 73b5a9ef-d9f7-5d93-a0bd-946dc7174c5f
		displayFolder: 02 Plan

	measure 'Actual last year' =
			VAR vFY = [Fiscal year]
			RETURN CALCULATE([Retail revenue], dim_month[year] = vFY - 1)
		formatString: \$#,0
		lineageTag: 4473b165-a97f-5f7f-b914-0513fbcb3aff
		displayFolder: 02 Plan

	measure 'MWh this year' =
			VAR vFY = [Fiscal year]
			RETURN CALCULATE([Retail MWh], dim_month[year] = vFY)
		formatString: #,0
		lineageTag: e6acb10d-a2fb-5ed7-a3fc-59d05b7f7047
		displayFolder: 02 Plan

	measure 'MWh last year to date' =
			VAR vFY = [Fiscal year]
			VAR vClosed = [Months closed]
			RETURN CALCULATE([Retail MWh], dim_month[year] = vFY - 1, dim_month[month_number] <= vClosed)
		formatString: #,0
		lineageTag: 68c1089e-aaff-5ae1-a9c9-67b8d94d681b
		displayFolder: 02 Plan

	measure 'Industrial load growth' = CALCULATE(DIVIDE([MWh this year], [MWh last year to date]) - 1, dim_class[class] = "industrial")
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: cb147dc6-df1d-50c3-9106-891b4e4e30c2
		displayFolder: 02 Plan

	measure 'Plan revenue' = SUM(plan_monthly[plan_revenue])
		formatString: \$#,0
		lineageTag: da5a7af4-6de6-5a68-81ac-fd7c984d6d25
		displayFolder: 02 Plan

	measure 'Plan revenue to date' =
			VAR vClosed = [Months closed]
			RETURN CALCULATE([Plan revenue], dim_month[month_number] <= vClosed)
		formatString: \$#,0
		lineageTag: 2aa827e7-fd84-5b5e-8c08-c166b667b762
		displayFolder: 02 Plan

	measure 'Against plan' = [Actual this year] - [Plan revenue to date]
		formatString: \$#,0
		lineageTag: 2b3b1ece-83eb-5a06-9de1-b091c1c8a032
		displayFolder: 02 Plan

	measure 'Against plan %' = DIVIDE([Against plan], [Plan revenue to date])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: c848e211-a79a-548a-b7af-5fe4349961de
		displayFolder: 02 Plan

	measure 'Forecast revenue' = SUM(forecast_monthly[forecast_revenue])
		formatString: \$#,0
		lineageTag: 414149fb-379c-5a41-9044-3cc3a6ac1d2b
		displayFolder: 02 Plan

	measure 'Outlook revenue' = [Actual this year] + [Forecast revenue]
		formatString: \$#,0
		lineageTag: 7483c80b-61d8-51a7-986a-9d80f2012181
		displayFolder: 02 Plan

	measure 'Outlook against plan' = [Outlook revenue] - [Plan revenue]
		formatString: \$#,0
		lineageTag: 955865d5-e625-576c-a091-750b237e4c80
		displayFolder: 02 Plan

	measure 'Outlook growth %' = DIVIDE([Outlook revenue], [Actual last year]) - 1
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 33958dec-161c-537b-850f-ddca7b0d3f33
		displayFolder: 02 Plan

	measure 'Bridge amount' = SUM(plan_bridge[amount])
		formatString: \$#,0
		lineageTag: ddea1109-08eb-503e-85df-948fbd51db80
		displayFolder: 03 Bridge

	measure 'Bridge effect' = CALCULATE([Bridge amount], plan_bridge[step] <> "Plan")
		formatString: \$#,0
		lineageTag: 79f17974-07c6-598f-ae34-89dc9a5bc160
		displayFolder: 03 Bridge

	measure 'Customer effect' = CALCULATE([Bridge amount], plan_bridge[step] = "Customers")
		formatString: \$#,0
		lineageTag: 7ed7f64c-9de4-532e-b9f0-2035e5a8a2c5
		displayFolder: 03 Bridge

	measure 'Weather effect' = CALCULATE([Bridge amount], plan_bridge[step] = "Weather")
		formatString: \$#,0
		lineageTag: d67c1a4b-4074-561d-902c-2e91f8f9b0f3
		displayFolder: 03 Bridge

	measure 'Usage effect' = CALCULATE([Bridge amount], plan_bridge[step] = "Usage")
		formatString: \$#,0
		lineageTag: 5ffe04e7-d5d2-52d1-b470-d91c4c65f337
		displayFolder: 03 Bridge

	measure 'Price effect' = CALCULATE([Bridge amount], plan_bridge[step] = "Price")
		formatString: \$#,0
		lineageTag: 068d564a-16bb-5bf0-9334-b55fa802150a
		displayFolder: 03 Bridge

	measure 'Backtest variance' = AVERAGE(backtest[variance_pct])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 84f1e7e9-5cea-54e6-8a87-39cf3ebb42f1
		displayFolder: 03 Bridge

	measure 'Revenue WAPE' = AVERAGE(backtest[wape_revenue_pct])
		formatString: 0.0%
		lineageTag: a22af873-6a08-5782-9e2d-a2d98e480e4a
		displayFolder: 03 Bridge

	measure 'MWh WAPE' = AVERAGE(backtest[wape_mwh_pct])
		formatString: 0.0%
		lineageTag: 34c3c20a-15f9-598d-9d90-7e9ac8c89212
		displayFolder: 03 Bridge

	measure 'Heating degree days' = SUM(fact_weather[hdd])
		formatString: #,0
		lineageTag: 1c77f65b-3ca3-5b8c-8b41-a995fd936caa
		displayFolder: 04 Weather

	measure 'Normal heating degree days' = SUM(fact_weather[normal_hdd])
		formatString: #,0
		lineageTag: 7b0446e2-8392-53f2-9612-d60753265707
		displayFolder: 04 Weather

	measure 'Cooling degree days' = SUM(fact_weather[cdd])
		formatString: #,0
		lineageTag: e8b43e7a-9460-56bb-b393-55be6969c549
		displayFolder: 04 Weather

	measure 'HDD this year' =
			VAR vFY = [Fiscal year]
			RETURN CALCULATE([Heating degree days], dim_month[year] = vFY)
		formatString: #,0
		lineageTag: ca7dd597-1d4c-5c6d-ba29-4ada5d6a1f3f
		displayFolder: 04 Weather

	measure 'Normal HDD this year' =
			VAR vFY = [Fiscal year]
			RETURN CALCULATE([Normal heating degree days], dim_month[year] = vFY)
		formatString: #,0
		lineageTag: 367b559b-afba-5465-a829-9cc7ae867e77
		displayFolder: 04 Weather

	measure 'HDD against normal %' =
			VAR vFY = [Fiscal year]
			VAR vClosed = [Months closed]
			VAR vActual = CALCULATE([Heating degree days], dim_month[year] = vFY, dim_month[month_number] <= vClosed)
			VAR vNormal = CALCULATE([Normal heating degree days], dim_month[year] = vFY, dim_month[month_number] <= vClosed)
			RETURN DIVIDE(vActual - vNormal, vNormal)
		formatString: +0%;-0%;0%
		lineageTag: 25e665b1-18d2-5baa-bd4d-54dc1f474c1b
		displayFolder: 04 Weather

	measure 'Weather load (GWh)' = SUM(weather_impact[weather_mwh]) / 1000
		formatString: +#,0;-#,0;0
		lineageTag: bb014eba-4704-5948-8e84-f3df8b34aaf7
		displayFolder: 04 Weather

	measure 'Weather revenue' = SUM(weather_impact[weather_revenue])
		formatString: \$#,0
		lineageTag: 99e6128e-ca4d-5940-9618-fd6f59bdbdeb
		displayFolder: 04 Weather

	measure 'Residential MWh per customer' = CALCULATE([MWh per customer], dim_class[class] = "residential")
		formatString: 0.000
		lineageTag: a5563607-9741-5fc2-b5dd-9eb33998b1eb
		displayFolder: 04 Weather

	measure 'Residential R²' = CALCULATE(MAX(weather_model[r_squared]), dim_class[class] = "residential")
		formatString: 0.000
		lineageTag: 813d72d3-f99c-560f-9680-8397db317d26
		displayFolder: 04 Weather

	measure 'Rate change value' = SELECTEDVALUE(RateChange[Rate change %], 0)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 6910759f-166c-5fa0-aeff-2e89361cd2bd
		displayFolder: 05 Scenarios

	measure 'Load change value' = SELECTEDVALUE(LoadChange[Industrial load change (MW)], 0)
		formatString: +#,0;-#,0;0
		lineageTag: bd0f3646-4b71-557a-916e-53c2c2730439
		displayFolder: 05 Scenarios

	measure 'Scenario outlook' =
			VAR vRate = [Rate change value]
			VAR vMW = [Load change value]
			VAR vIndustrial = SUMX(FILTER(forecast_monthly, forecast_monthly[class] = "industrial"),
			    forecast_monthly[days] * 24 * forecast_monthly[forecast_price])
			RETURN [Actual this year] + ([Forecast revenue] + vMW * vIndustrial) * (1 + vRate)
		formatString: \$#,0
		lineageTag: 4893095d-a3eb-52ef-bae4-3c18d78d9afa
		displayFolder: 05 Scenarios

	measure 'Scenario against plan' = [Scenario outlook] - [Plan revenue]
		formatString: \$#,0
		lineageTag: 924747fe-9ca8-5d59-899e-752cac98f475
		displayFolder: 05 Scenarios

	measure 'Tornado impact' = SUM(tornado[impact])
		formatString: \$#,0
		lineageTag: 5580fe73-674b-5c76-984c-55fad0e203c0
		displayFolder: 05 Scenarios

	measure 'Sensitivity outlook' = SUM(sensitivity[outlook_revenue])
		formatString: \$#,0
		lineageTag: c6927ccf-781e-53f4-9d7e-eb3a21b6254c
		displayFolder: 05 Scenarios

	measure 'PVM amount' =
			VAR vOrder = CALCULATE(MIN(pvm[period_order]), REMOVEFILTERS(pvm[revenue_class], pvm[step]))
			RETURN CALCULATE(SUM(pvm[amount]), KEEPFILTERS(pvm[period_order] = vOrder))
		formatString: \$#,0
		lineageTag: 825af9fa-1d1e-5efb-827a-e40852e5648a
		displayFolder: 06 PVM

	measure 'PVM opening revenue' = CALCULATE([PVM amount], pvm[step] = "Opening revenue")
		formatString: \$#,0
		lineageTag: 77ac30a7-3eaf-5f50-a614-62b2c2738fc7
		displayFolder: 06 PVM

	measure 'PVM volume' = CALCULATE([PVM amount], pvm[step] = "Volume")
		formatString: \$#,0
		lineageTag: c3116b12-c141-58fd-9437-63b18a5a7b2d
		displayFolder: 06 PVM

	measure 'PVM mix' = CALCULATE([PVM amount], pvm[step] = "Mix")
		formatString: \$#,0
		lineageTag: 97388ef9-b536-5e36-b2be-f19c9ecd3f50
		displayFolder: 06 PVM

	measure 'PVM price' = CALCULATE([PVM amount], pvm[step] = "Price")
		formatString: \$#,0
		lineageTag: be77b70e-ef83-5f33-8aaa-05a2b8cb52f1
		displayFolder: 06 PVM

	measure 'P&L ($M)' = DIVIDE(SUM(ferc_pnl[value]), 1000000)
		formatString: #,0.0
		lineageTag: e42c0ab4-d931-51d7-8f7c-9d9e98971755
		displayFolder: 07 FERC

	measure 'Operating margin %' = DIVIDE(SUM(ferc_years[operating_income]), SUM(ferc_years[total_revenue]))
		formatString: 0.0%
		lineageTag: 5f64adc2-2b5b-5d69-9b44-9b2e37349d60
		displayFolder: 07 FERC

	measure 'FERC retail price (cents/kWh)' = DIVIDE(SUM(ferc_years[retail_revenue]), SUM(ferc_years[retail_mwh])) / 10
		formatString: 0.00
		lineageTag: a802ab40-fc20-5912-bd20-7fd902454f03
		displayFolder: 07 FERC

	measure 'Power cost per MWh' = DIVIDE(SUM(ferc_years[power_cost]), SUM(ferc_years[total_mwh]))
		formatString: \$#,0.00
		lineageTag: 64c5f16c-2084-5fd3-84cd-1a4c79202619
		displayFolder: 07 FERC

	measure 'Operating margin, latest year' =
			VAR vYear = CALCULATE(MAX(ferc_years[year]), REMOVEFILTERS(ferc_years))
			RETURN CALCULATE([Operating margin %], ferc_years[year] = vYear)
		formatString: 0.0%
		lineageTag: ccb05b6a-100a-5bc6-90d9-2623911af2c9
		displayFolder: 07 FERC

	measure 'Retail price, latest year (cents/kWh)' =
			VAR vYear = CALCULATE(MAX(ferc_years[year]), REMOVEFILTERS(ferc_years))
			RETURN CALCULATE([FERC retail price (cents/kWh)], ferc_years[year] = vYear)
		formatString: 0.00
		lineageTag: 72fc4a5a-6cd2-5a83-970d-000969fabc91
		displayFolder: 07 FERC

	measure 'Power cost per MWh, latest year' =
			VAR vYear = CALCULATE(MAX(ferc_years[year]), REMOVEFILTERS(ferc_years))
			RETURN CALCULATE([Power cost per MWh], ferc_years[year] = vYear)
		formatString: \$#,0.00
		lineageTag: 91040695-16d4-589a-b508-eeed53feed33
		displayFolder: 07 FERC

	measure 'PGE industrial load growth' = CALCULATE(AVERAGE(peers[industrial_mwh_cagr_pct]), REMOVEFILTERS(peers), peers[is_pge] = TRUE())
		formatString: 0.0%
		lineageTag: ec6e8548-6fff-5d91-9c44-689811f5f672
		displayFolder: 07 FERC

	measure 'Industrial load growth a year' = AVERAGE(peers[industrial_mwh_cagr_pct])
		formatString: 0.0%
		lineageTag: d36e9ce2-c1fe-51fd-9b0d-4ddb12320883
		displayFolder: 07 FERC

	measure 'Peer ¢/kWh' = AVERAGE(peers[retail_cents])
		formatString: 0.00
		lineageTag: 17455f89-7962-51e8-8bf9-45e44f554a48
		displayFolder: 07 FERC

	measure 'Peer margin' = AVERAGE(peers[operating_margin_pct])
		formatString: 0.0%
		lineageTag: 2950a225-588e-56a9-bbf1-40204a2aa73b
		displayFolder: 07 FERC

	measure 'Peer power $/MWh' = AVERAGE(peers[power_cost_per_mwh])
		formatString: \$#,0.00
		lineageTag: 9d1e8e3a-cabe-56a6-a698-d2aca7f02791
		displayFolder: 07 FERC

	measure 'EIA MWh' = SUM(tieout[eia_mwh])
		formatString: #,0
		lineageTag: c0e702f5-1a6f-521d-a309-8db5611e10e5
		displayFolder: 08 Reconciliation

	measure 'EIA revenue' = SUM(tieout[eia_revenue])
		formatString: \$#,0
		lineageTag: 253364ce-7736-58e7-812c-b940b4e62a36
		displayFolder: 08 Reconciliation

	measure 'FERC revenue' = SUM(tieout[ferc_revenue])
		formatString: \$#,0
		lineageTag: 0333d24b-454e-55e5-a2d4-910564eacab4
		displayFolder: 08 Reconciliation

	measure 'FERC MWh' = SUM(tieout[ferc_mwh])
		formatString: #,0
		lineageTag: a883a9f4-6d4c-5fd3-bf1d-0631a4631869
		displayFolder: 08 Reconciliation

	measure 'MWh gap %' = ROUND(DIVIDE(SUM(tieout[eia_mwh]) - SUM(tieout[ferc_mwh]), SUM(tieout[ferc_mwh])), 5)
		formatString: +0.000%;-0.000%;0.000%
		lineageTag: bb657ae9-ce66-5fd5-90cb-10c2fcbff088
		displayFolder: 08 Reconciliation

	measure 'Revenue gap %' = DIVIDE(SUM(tieout[eia_revenue]) - SUM(tieout[ferc_revenue]), SUM(tieout[ferc_revenue]))
		formatString: +0.000%;-0.000%;0.000%
		lineageTag: 9b091e00-0cfc-59eb-bb25-b410b4d81131
		displayFolder: 08 Reconciliation

	measure 'Outlook reference' = "plan " & FORMAT([Plan revenue] / 1000000000, "$0.00") & "B · " & FORMAT([Outlook growth %], "+0.0%;-0.0%") & " on last year"
		lineageTag: 3dc516fd-0875-5834-acfe-a6dab012f049
		displayFolder: 09 Captions

	measure 'Against plan reference' =
			VAR vFY = [Fiscal year]
			VAR vClosed = [Months closed]
			RETURN FORMAT([Against plan %], "+0.0%;-0.0%") & " · Jan–" & FORMAT(DATE(vFY, vClosed, 1), "mmm yyyy")
		lineageTag: 77061e87-f24a-55e1-a36d-2e230b83de72
		displayFolder: 09 Captions

	measure 'Weather reference' = FORMAT([Weather revenue] / 1000000, "$#,0.0;-$#,0.0") & "M · HDD " & FORMAT([HDD against normal %], "+0%;-0%") & " vs normal"
		lineageTag: 92bce352-85a7-5e5a-bffb-4eae4446b5e7
		displayFolder: 09 Captions

	measure 'Industrial reference' = "MWh against the same months last year"
		lineageTag: b1d33721-b4f7-5a41-986f-1d710a1f570f
		displayFolder: 09 Captions

	measure 'Scenario reference' = FORMAT([Scenario against plan] / 1000000, "+$#,0.0;-$#,0.0") & "M against plan"
		lineageTag: a395fefd-15fc-5e4c-ad62-6b5d19630a04
		displayFolder: 09 Captions

	measure 'Actual ($M)' = DIVIDE([Actual this year], 1000000)
		formatString: \$#,0.0
		lineageTag: b7ae9685-54a9-57a5-bc02-f0b85427946a
		displayFolder: 10 Tables ($M)

