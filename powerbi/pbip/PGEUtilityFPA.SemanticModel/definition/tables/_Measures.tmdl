			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='#7d7d85'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 705102fc-e68c-5f74-9d44-f8a3f921807d
		dataCategory: ImageUrl
		displayFolder: Report UI

	column _placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e1366f0d-34fb-5d66-ab46-e8e9e22bfa9a
		summarizeBy: none
		sourceColumn: _placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [_placeholder = Int64.Type], {{0}})
				in
				    Source
