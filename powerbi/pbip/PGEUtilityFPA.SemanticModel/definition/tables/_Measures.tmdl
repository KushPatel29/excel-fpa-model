		displayFolder: 10 Tables ($M)

	measure 'Usage ($M)' = DIVIDE([Usage effect], 1000000)
		formatString: \$#,0.0
		lineageTag: 14c9ddd9-06ba-5e3d-8c11-0d3c0c73015a
		displayFolder: 10 Tables ($M)

	measure 'Price ($M)' = DIVIDE([Price effect], 1000000)
		formatString: \$#,0.0
