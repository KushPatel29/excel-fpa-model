	measure 'FERC revenue ($M)' = DIVIDE([FERC revenue], 1000000)
		formatString: \$#,0.0
		lineageTag: e25b869c-5b13-58bf-99ed-79252766ab02
		displayFolder: 10 Tables ($M)

	measure 'Filter Context - Overview' =
			VAR vText = IF(ISFILTERED('dim_class'[class_label]), CONCATENATEX(VALUES('dim_class'[class_label]), 'dim_class'[class_label], ", "), "all customer classes")
			RETURN IF(LEN(vText) > 72, LEFT(vText, 70) & "…", vText)
		lineageTag: 88934f45-4dd0-5ef5-b727-e1a43815090a
